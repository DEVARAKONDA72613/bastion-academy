# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example belongs in git.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Keep 'lax' for local/same-site deploys. For separate frontend/API domains, use 'none' with NODE_ENV=production.
SESSION_COOKIE_SAME_SITE=lax

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/bastion_academy

# Sessions / JWT
SESSION_SECRET=replace-with-a-long-random-value
JWT_SECRET=replace-with-a-different-long-random-value
SESSION_TTL_HOURS=720

# Argon2 (password hashing) — defaults are fine for dev, tune for prod
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# Razorpay (Test Mode — get these from the Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Object storage (S3-compatible — AWS S3, Cloudflare R2, etc.)
STORAGE_ENDPOINT=
STORAGE_BUCKET=bastion-videos
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1
CDN_BASE_URL=

# Email (OTP + notifications) — swap adapter in src/core/notify/email.ts
EMAIL_PROVIDER=mock
EMAIL_API_KEY=

# SMS (OTP) — swap adapter in src/core/notify/sms.ts
SMS_PROVIDER=mock
SMS_API_KEY=

# Translation
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=

# WebRTC signaling / SFU
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
